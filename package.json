{
  "name": "melt-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A tactile, real-market portfolio sandbox. Move capital, see the balance change.",
  "license": "MIT",
  "author": "Phillip Vedder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhillipVedder/melt-portfolio.git"
  },
  "homepage": "https://github.com/PhillipVedder/melt-portfolio#readme",
  "bugs": {
    "url": "https://github.com/PhillipVedder/melt-portfolio/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "security:check": "node scripts/check-secrets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "d3-force": "^3.0.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@types/d3-force": "^3.0.10",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "4.1.11"
  }
}
